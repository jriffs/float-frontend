{
	"name": "float-frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"$lib": "./src/lib/index.js",
		"$lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.4",
		"@types/bn.js": "^5.2.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vite-plugin-node-polyfills": "^0.28.0"
	},
	"dependencies": {
		"@coral-xyz/anchor": "^0.32.1",
		"@fontsource-variable/fredoka": "^5.3.0",
		"@fontsource-variable/nunito": "^5.3.0",
		"@lucide/svelte": "^1.69.0",
		"@rollup/plugin-inject": "^5.0.5",
		"@solana/spl-token": "^0.4.15",
		"@solana/wallet-adapter-backpack": "^0.1.14",
		"@solana/wallet-adapter-base": "^0.9.28",
		"@solana/wallet-adapter-phantom": "^0.9.30",
		"@solana/wallet-adapter-solflare": "^0.6.34",
		"@solana/web3.js": "^1.99.0",
		"@supabase/supabase-js": "^2.119.0",
		"bn.js": "^5.2.5",
		"buffer": "^6.0.3"
	},
	"allowScripts": {
		"bufferutil@4.1.0": true,
		"utf-8-validate@6.0.6": true,
		"bigint-buffer@1.1.5": true
	}
}
